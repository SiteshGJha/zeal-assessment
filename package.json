{
  "name": "zeal-entitlement-support-platform",
  "version": "1.0.0",
  "description": "Customer Entitlement & Support Case Platform API and MCP Server",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "node --env-file-if-exists=.env node_modules/.bin/nest start --watch",
    "dev": "npm run start:dev",
    "lint": "eslint \"src/**/*.ts\" \"mcp/**/*.ts\" \"tests/**/*.ts\" && tsc --noEmit",
    "test": "jest tests/unit",
    "test:e2e": "jest --runInBand tests/integration",
    "test:contract": "jest --runInBand tests/contract",
    "test:mcp": "jest --runInBand tests/mcp",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node --env-file-if-exists=.env dist/prisma/seed.js",
    "mcp:start": "node --env-file-if-exists=.env dist/mcp/server.js",
    "demo:mcp": "node --env-file-if-exists=.env dist/mcp/demo/run-demo.js",
    "token:mint": "node --env-file-if-exists=.env dist/src/scripts/mint-token.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.6.0",
    "fast-xml-parser": "^4.5.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "yaml": "^2.7.1"
  }
}
